<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #ffffff; color: #111827; -webkit-font-smoothing: antialiased;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
            <td align="center" style="padding: 80px 20px;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 480px;">
                    <!-- Branding -->
                    <tr>
                        <td align="left" style="padding-bottom: 40px;">
                            <div style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: #000000;">
                                THALORIX
                            </div>
                        </td>
                    </tr>
                    
                    <!-- Main Content -->
                    <tr>
                        <td align="left">
                            <h1 style="margin: 0 0 16px 0; font-size: 24px; font-weight: 600; color: #111827;">Confirm your email</h1>
                            <p style="margin: 0 0 32px 0; font-size: 16px; line-height: 1.5; color: #4b5563;">
                                Welcome to Thalorix, {{name}}. Please click the button below to verify your email address and activate your account.
                            </p>
                            
                            <!-- Sleek CTA Button -->
                            <div style="margin: 32px 0;">
                                <a href="{{verificationLink}}" target="_blank" style="display: inline-block; padding: 14px 28px; background-color: #000000; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 15px; font-weight: 600;">
                                    Verify email address
                                </a>
                            </div>
                            
                            <!-- Security Info -->
                            <div style="padding: 20px; border-top: 1px solid #f3f4f6;">
                                <p style="margin: 0; font-size: 14px; color: #6b7280; line-height: 1.5;">
                                    This link is for your account only. If you didn't create an account, you can ignore this email.
                                </p>
                                <p style="margin: 12px 0 0 0; font-size: 12px; color: #9ca3af; word-break: break-all;">
                                    Fallback link: <br>
                                    <a href="{{verificationLink}}" style="color: #4b5563;">{{verificationLink}}</a>
                                </p>
                            </div>
                        </td>
                    </tr>
                    
                    <!-- Minimalist Footer -->
                    <tr>
                        <td align="left" style="padding-top: 60px; border-top: 1px solid #f3f4f6; margin-top: 60px;">
                            <p style="margin: 0; font-size: 12px; color: #9ca3af; line-height: 1.5;">
                                &copy; {{year}} Thalorix Inc. <br>
                                Security at your fingertips.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
